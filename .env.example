# Optional: without a .env everything runs in local mode with the defaults below.
#
# Tracker backend, picked automatically (logged once per run):
# 1. github-app – all three GITHUB_APP_* set: GitHub issues, commits, tags and pushes as the GitHub App bot.
# 2. pat        – else GH_TOKEN and GITHUB_REPO set: the same GitHub issues as your token's user; registry commits
#                 and tags stay local (author frankenstein-bot <frankenstein-bot@localhost>), nothing is pushed.
# 3. local      – otherwise: issues in tracker/issues/<n>.md; registry commits and tags stay local as in pat mode.

# 1. github-app
GITHUB_APP_ID=
# Path to the App's private key (*.pem, never committed)
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=

# 2. pat: a token that can create labels and issues on GITHUB_REPO (fine-grained: Issues read/write)
GH_TOKEN=
# owner/name; also used by github-app
GITHUB_REPO=

# Caps enforced by scripts/hooks/budget.ts. Unset: 5 USD and 3 builder iterations; an invalid value denies every
# tool call.
BUDGET_USD_PER_RUN=5
MAX_BUILDER_ITERATIONS=3
# Comma-separated domains scripts/record-fixture.ts may fetch (subdomains included). Read only from this file:
# a value set in the shell environment is ignored.
FIXTURE_ALLOWED_DOMAINS=
# Comma-separated directories (repo-relative or absolute) whose files scripts/run-skill.ts may mount with --mount.
# Read only from this file: a value set in the shell environment is ignored. Empty: demo/data,inputs,out (out: one
# skill's output feeds another).
INPUT_ALLOWED_ROOTS=
