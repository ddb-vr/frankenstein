{
  "skill": "text-stats-broken",
  "entry": "scripts/main.ts",
  "examples": [
    {
      "name": "two words",
      "input": {
        "text": "hello world"
      },
      "expected": {
        "words": 3,
        "chars": 11
      },
      "match": "exact"
    },
    {
      "name": "empty text",
      "input": {
        "text": ""
      },
      "expected": {
        "words": 0
      },
      "match": "subset"
    },
    {
      "name": "missing text",
      "input": {},
      "expected": {
        "error": true
      },
      "match": "exact"
    }
  ]
}
