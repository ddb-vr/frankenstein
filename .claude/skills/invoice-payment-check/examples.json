{
  "skill": "invoice-payment-check",
  "entry": "scripts/main.ts",
  "examples": [
    {
      "name": "full-run-summary",
      "input": {
        "statement": "/skill/fixtures/input/bank-statement.csv",
        "invoices": "/skill/fixtures/input/invoices.csv"
      },
      "expected": {
        "asOf": "2026-08-28",
        "currency": "CZK",
        "invoices": 8,
        "paid": 4,
        "overpaid": 1,
        "partlyPaid": 1,
        "unpaid": 2,
        "overdue": 2,
        "totalOwed": 21905,
        "overdueOwed": 18880,
        "toCheck": 1,
        "unmatchedPayments": 2
      },
      "match": "subset"
    },
    {
      "name": "explicit-utf8-encodings",
      "input": {
        "statement": "/skill/fixtures/input/bank-statement.csv",
        "invoices": "/skill/fixtures/input/invoices.csv",
        "statementEncoding": "utf-8",
        "invoicesEncoding": "utf-8"
      },
      "expected": {
        "invoices": 8,
        "paid": 4,
        "partlyPaid": 1,
        "unpaid": 2,
        "overpaid": 1
      },
      "match": "subset"
    },
    {
      "name": "error-invoices-missing-columns",
      "input": {
        "statement": "/skill/fixtures/input/bank-statement.csv",
        "invoices": "/skill/fixtures/input/invoices-bad-header.csv"
      },
      "expected": { "error": true },
      "match": "exact"
    },
    {
      "name": "error-files-swapped",
      "input": {
        "statement": "/skill/fixtures/input/invoices.csv",
        "invoices": "/skill/fixtures/input/bank-statement.csv"
      },
      "expected": { "error": true },
      "match": "exact"
    },
    {
      "name": "error-file-not-found",
      "input": {
        "statement": "/skill/fixtures/input/does-not-exist.csv",
        "invoices": "/skill/fixtures/input/invoices.csv"
      },
      "expected": { "error": true },
      "match": "exact"
    },
    {
      "name": "error-missing-invoices-field",
      "input": { "statement": "/skill/fixtures/input/bank-statement.csv" },
      "expected": { "error": true },
      "match": "exact"
    }
  ]
}
