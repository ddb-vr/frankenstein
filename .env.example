GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=
# owner/name
GITHUB_REPO=
# Caps enforced by scripts/hooks/budget.ts; required, it denies every tool call while unset.
BUDGET_USD_PER_RUN=
MAX_BUILDER_ITERATIONS=
# Comma-separated domains scripts/record-fixture.ts may fetch (subdomains included). Read only from this file:
# a value set in the shell environment is ignored. The ARES demo needs ares.gov.cz.
FIXTURE_ALLOWED_DOMAINS=ares.gov.cz
# n8n (the n8n route, scripts/n8n.ts): the instance URL and an API key with workflow, credential,
# execution and tag scopes. N8N_WEBHOOK_SECRET is generated by `instance init` when missing.
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
