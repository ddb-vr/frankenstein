{
  "skill": "payment-reminders",
  "entry": "scripts/main.ts",
  "examples": [
    {
      "name": "normal-two-customers",
      "input": {
        "invoiceStatus": "/skill/fixtures/input/invoice-status.csv",
        "toCheck": "/skill/fixtures/input/to-check.csv",
        "today": "2026-10-09",
        "asOf": "2026-09-30"
      },
      "expected": {
        "today": "2026-10-09",
        "customersToRemind": 2,
        "invoicesToRemind": 4,
        "totalMissing": 29000,
        "currency": "CZK",
        "manualCheck": 1
      },
      "match": "subset"
    },
    {
      "name": "exactly-30-days-not-late-enough",
      "input": {
        "invoiceStatus": "/skill/fixtures/input/invoice-status.csv",
        "toCheck": "/skill/fixtures/input/to-check.csv",
        "today": "2026-10-29"
      },
      "expected": {
        "customersToRemind": 2,
        "invoicesToRemind": 4,
        "totalMissing": 29000,
        "manualCheck": 1
      },
      "match": "subset"
    },
    {
      "name": "31-days-includes-gama",
      "input": {
        "invoiceStatus": "/skill/fixtures/input/invoice-status.csv",
        "toCheck": "/skill/fixtures/input/to-check.csv",
        "today": "2026-10-30"
      },
      "expected": {
        "customersToRemind": 3,
        "invoicesToRemind": 5,
        "totalMissing": 34000,
        "manualCheck": 1
      },
      "match": "subset"
    },
    {
      "name": "nobody-late-yet",
      "input": {
        "invoiceStatus": "/skill/fixtures/input/invoice-status.csv",
        "toCheck": "/skill/fixtures/input/to-check.csv",
        "today": "2026-07-05"
      },
      "expected": {
        "customersToRemind": 0,
        "invoicesToRemind": 0,
        "totalMissing": 0
      },
      "match": "subset"
    },
    {
      "name": "optional-signature-and-currency",
      "input": {
        "invoiceStatus": "/skill/fixtures/input/invoice-status.csv",
        "toCheck": "/skill/fixtures/input/to-check.csv",
        "today": "2026-10-09",
        "currency": "EUR",
        "senderName": "Jana Nováková",
        "senderCompany": "Novák Služby s.r.o.",
        "bankAccount": "123456789/0100",
        "contact": "jana@example.cz"
      },
      "expected": {
        "customersToRemind": 2,
        "totalMissing": 29000,
        "currency": "EUR"
      },
      "match": "subset"
    },
    {
      "name": "error-invalid-today",
      "input": {
        "invoiceStatus": "/skill/fixtures/input/invoice-status.csv",
        "toCheck": "/skill/fixtures/input/to-check.csv",
        "today": "09.10.2026"
      },
      "expected": { "error": true },
      "match": "exact"
    },
    {
      "name": "error-missing-file",
      "input": {
        "invoiceStatus": "/skill/fixtures/input/does-not-exist.csv",
        "toCheck": "/skill/fixtures/input/to-check.csv",
        "today": "2026-10-09"
      },
      "expected": { "error": true },
      "match": "exact"
    },
    {
      "name": "error-swapped-files",
      "input": {
        "invoiceStatus": "/skill/fixtures/input/to-check.csv",
        "toCheck": "/skill/fixtures/input/invoice-status.csv",
        "today": "2026-10-09"
      },
      "expected": { "error": true },
      "match": "exact"
    }
  ]
}
