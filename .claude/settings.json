{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(node:*)",
      "Bash(npm run:*)",
      "Bash(docker:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git describe:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Edit(/.claude/skills/**)",
      "Edit(/work/.locks/**)",
      "Edit(/.claude/settings.json)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Bash(gh:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git diff --no-index:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/budget.ts"]
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/guard-files.ts"]
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/guard-bash.ts"]
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/capture-review.ts"]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "skill-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/capture-review.ts"]
          }
        ]
      }
    ]
  }
}
